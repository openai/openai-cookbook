RESEND_API_KEY=your-resend-api-key
AUMARA_AUTOMATION_MODE=off
AUMARA_LIVE_SEND_CONFIRMED=false
AUMARA_ALLOW_ACCESS_CODES=false
AUMARA_MAIL_FROM="AUMARA El Cid <stay@verified-domain.example>"
AUMARA_MAIL_REPLY_TO="ops@example.test"
AUMARA_TEST_TO="test@example.test"
AUMARA_TEST_EMAIL_CONFIRMED=false
AUMARA_TEST_EMAIL_IDEMPOTENCY_KEY=replace-with-a-unique-key
AUMARA_ENV=local
AUMARA_WEBHOOK_TOKEN=change-this-token
AUMARA_DASHBOARD_TOKEN=
AUMARA_DAILY_OPS_SNAPSHOT=/var/lib/aumara-control-tower/daily-ops/latest.json
AUMARA_MAX_BODY_BYTES=65536
AUMARA_IDEMPOTENCY_TTL_SECONDS=604800
PORT=8787
