{
  "name": "aumara-control-tower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "health": "node --env-file-if-exists=.env src/healthcheck.mjs",
    "test": "node --test src/*.test.mjs",
    "test:email": "node --env-file-if-exists=.env src/send-test-email.mjs"
  },
  "dependencies": {
    "@resend/node": "latest"
  }
}
