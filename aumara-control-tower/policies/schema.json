{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aumara:policy-registry:1.0",
  "title": "AUMARA and EL CID Policy Registry",
  "$defs": {
    "registry_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_version",
        "schema_file",
        "registries",
        "source_precedence"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "policy_version": {
          "$ref": "#/$defs/version"
        },
        "schema_file": {
          "const": "schema.json"
        },
        "registries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shared",
            "elcid",
            "aumara"
          ],
          "properties": {
            "shared": {
              "const": "shared.yaml"
            },
            "elcid": {
              "const": "elcid.yaml"
            },
            "aumara": {
              "const": "aumara.yaml"
            }
          }
        },
        "source_precedence": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "verified_beds24_configuration",
              "verified_booking_com_configuration",
              "official_property_documentation",
              "approved_internal_document",
              "confirmed_guest_reply"
            ]
          }
        }
      }
    },
    "policy_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_version",
        "property",
        "policies"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "policy_version": {
          "$ref": "#/$defs/version"
        },
        "property": {
          "$ref": "#/$defs/property"
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/policy"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "property",
        "category",
        "rule",
        "source",
        "source_reference",
        "verified_at",
        "status",
        "allowed_auto_reply",
        "allowed_beds24_action",
        "escalation_conditions",
        "response_template_ids",
        "policy_version"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^(shared|elcid|aumara)\\.[a-z0-9][a-z0-9.-]*$"
        },
        "property": {
          "$ref": "#/$defs/property"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "verified_beds24_configuration",
            "verified_booking_com_configuration",
            "official_property_documentation",
            "approved_internal_document",
            "confirmed_guest_reply"
          ]
        },
        "source_reference": {
          "type": "string",
          "pattern": "^(REQUEST|BEDS24|BOOKING_COM|WEBSITE|INTERNAL_DOC|GUEST_REPLY):[A-Z0-9_.:-]+$"
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "enum": [
            "verified",
            "conflict",
            "pending"
          ]
        },
        "allowed_auto_reply": {
          "type": "boolean"
        },
        "allowed_beds24_action": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "record_guest_request"
            ]
          }
        },
        "escalation_conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "response_template_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(shared|elcid|aumara)\\.[a-z0-9][a-z0-9.-]*$"
          }
        },
        "policy_version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "property": {
      "enum": [
        "shared",
        "elcid",
        "aumara"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$"
    }
  }
}
