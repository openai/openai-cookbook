{
  "organisation_id": "example-company",
  "organisation_model_version": "example-security-baseline-v1",
  "organisation_controls": [
    "audit_logging",
    "encryption_at_rest",
    "identity_governance",
    "network_segmentation"
  ],
  "owners": {
    "scope_authorizer": ["security-owner"],
    "model_reviewer": ["threat-owner"],
    "security_reviewer": ["finding-owner"],
    "patch_reviewer": ["patch-owner"],
    "merge_owner": ["repository-owner"],
    "deploy_owner": ["release-owner"],
    "exception_owner": ["risk-owner"],
    "policy_owner": ["policy-owner"]
  },
  "policy": {
