{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "live-smoke.ts",
    "trace-smoke.ts",
    "server.ts",
    "providers/**/*.ts",
    "schemas/**/*.ts",
    "tests/**/*.ts"
  ]
}
