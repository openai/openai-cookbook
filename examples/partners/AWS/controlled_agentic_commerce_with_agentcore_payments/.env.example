# AgentCore Payments preview: testnet only. Do not commit real values.
ALLOW_AGENTCORE_TESTNET=0
# Enables two read-only calls: instrument state and the exact Base Sepolia
# USDC balance scope. They cannot create a session, generate a proof, contact
# a merchant, or transfer value.
ALLOW_AGENTCORE_READ_ONLY=0
# Master gate for the notebook-managed create -> combined run -> delete path.
RUN_AGENTCORE_E2E=0
# The combined live command also requires both flags below. Keep them off
# until the exact 0.002-test-USDC run is reviewed immediately before use.
ALLOW_PAID_INFERENCE=0
APPROVE_AGENTCORE_TESTNET_PURCHASE=0
# This separate opt-in permits only bounded session create/delete operations.
ALLOW_AGENTCORE_SESSION_ADMIN=0
AGENTCORE_SESSION_FILE=.agentcore-session.env
# Keep the payment-execution profile separate from the profiles used for model
# inference and session administration. For a local test, the model and session
# profiles may refer to the same approved developer identity.
BEDROCK_AWS_PROFILE=
AGENTCORE_SESSION_AWS_PROFILE=
AGENTCORE_RUNTIME_AWS_PROFILE=
# Keep this separate from AWS_REGION=us-east-2 used by Bedrock Mantle.
AGENTCORE_AWS_REGION=us-east-1
PAYMENT_MANAGER_ARN=
PAYMENT_CONNECTOR_ID=
PAYMENT_INSTRUMENT_ID=
PAYMENT_SESSION_ID=
PAYMENT_USER_ID=
X402_ALLOWED_MERCHANTS=sandbox.node4all.com
X402_NETWORK_PREFERENCES=eip155:84532
# Base Sepolia USDC contract. This is a public asset identifier, not a wallet.
X402_APPROVED_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Exact testnet merchant recipient from the reviewed challenge. Keep the real
# value only in the ignored local .env file; never commit or log it.
X402_APPROVED_PAY_TO=
# Reject merchant challenges that delegate payment authority for longer.
X402_MAX_CHALLENGE_TIMEOUT_SECONDS=300
# Current sandbox price: 2,000 atomic units = 0.002 test USDC.
X402_MAX_APPROVED_AMOUNT_ATOMIC=2000
X402_MAX_PAYMENT_ATTEMPTS=1
# The reviewed sandbox binds the exact query string into its x402 challenge.
X402_RESOURCE_URL=https://sandbox.node4all.com/v1/x402-test?host=sandbox.node4all.com
X402_IDEMPOTENCY_KEY=
