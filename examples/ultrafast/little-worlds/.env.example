# Copy to .env and set your own key. Never commit .env or put keys in VITE_* variables.
OPENAI_API_KEY=

# GPT-6 Astra supports Ultrafast for API users, subject to project rate limits.
# Ultrafast supports global processing and US data residency.
LITTLE_WORLDS_MODEL=gpt-6-astra
LITTLE_WORLDS_TIER=ultrafast
LITTLE_WORLDS_TRANSPORT=auto
# Optional global voice: speech uses GPT-Live; UI planning and code builds keep
# LITTLE_WORLDS_MODEL / LITTLE_WORLDS_TIER and low reasoning. Requires GPT-Live access.
LITTLE_WORLDS_LIVE_MODEL=gpt-live-1
# Optional generated space icons require access to this image model.
SPACE_ICON_MODEL=gpt-image-2.5-flare
HEALTH_CHAT_MODEL=gpt-6-astra
HEALTH_CHAT_TIER=ultrafast

# Use saved for demos where outbound news requests are blocked. This skips
# the Federal Reserve request entirely and labels the dated reading list.
FINANCE_NEWS_MODE=feed

# Keep this at 4318 when using the included Vite development proxy.
PORT=4318
