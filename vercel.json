{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/elcid-site/index.html"
    },
    {
      "source": "/styles.css",
      "destination": "/elcid-site/styles.css"
    },
    {
      "source": "/site.js",
      "destination": "/elcid-site/site.js"
    },
    {
      "source": "/official-logo.svg",
      "destination": "/elcid-site/official-logo.svg"
    },
    {
      "source": "/legal.html",
      "destination": "/elcid-site/legal.html"
    },
    {
      "source": "/privacy.html",
      "destination": "/elcid-site/privacy.html"
    },
    {
      "source": "/cookies.html",
      "destination": "/elcid-site/cookies.html"
    },
    {
      "source": "/aumara",
      "destination": "/aumara-site/direct-v2.html"
    },
    {
      "source": "/aumara/",
      "destination": "/aumara-site/direct-v2.html"
    },
    {
      "source": "/staff",
      "destination": "/staff/index.html"
    },
    {
      "source": "/staff/",
      "destination": "/staff/index.html"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/elcid-site/index.html"
    },
    {
      "src": "^/(styles\\.css|site\\.js|official-logo\\.svg|legal\\.html|privacy\\.html|cookies\\.html)$",
      "dest": "/elcid-site/$1"
    },
    {
      "src": "^/aumara/?$",
      "dest": "/aumara-site/direct-v2.html"
    },
    {
      "src": "^/staff/?$",
      "dest": "/staff/index.html"
    },
    {
      "src": "^/.*$",
      "status": 404
    }
  ]
}
